{
  "name": "flowsync-chrome-extension",
  "private": true,
  "version": "0.1.0",
  "description": "FlowSync Chrome extension — watches browsing activity across the gaps between your tools.",
  "scripts": {
    "build": "esbuild src/background.ts --bundle --outfile=dist/background.js --format=iife --platform=browser --target=chrome116 --sourcemap",
    "watch": "esbuild src/background.ts --bundle --outfile=dist/background.js --format=iife --platform=browser --target=chrome116 --sourcemap --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  }
}